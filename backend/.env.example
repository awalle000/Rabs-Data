# Server
NODE_ENV=development
PORT=5000
# Comma separated if you have more than one (e.g. your Vercel URL and localhost)
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/rabsdata

# Auth (use 32+ random characters in production)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# App settings
WALLET_ENABLED=true
# Leave empty for all networks, or list e.g. MTN,Telecel
ENABLED_NETWORKS=

# Experiential Labs model gateway (OpenAI-compatible)
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=

# Paystack secret is backend-only. Configure this webhook in the Paystack dashboard:
# https://<API_PUBLIC_URL>/api/payments/webhook/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Public HTTPS backend URL; configure Paystack's webhook at the URL shown above.
API_PUBLIC_URL=http://localhost:5000

# Web Push for authenticated administrators only. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
# Keep the private key on the backend; VAPID_PUBLIC_KEY is returned only by a protected admin API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rabsdata.com

# Historical Hubtel verification only. Never used to initialize new payments.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
# Used only by the legacy status fallback; never used to initialize new payments.
HUBTEL_CHECKOUT_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_STATUS_BASE_URL=https://api-txnstatus.hubtel.com
# Historical callback authentication.
HUBTEL_WEBHOOK_TOKEN=
# Historical fee policy fallback for old orders without a persisted policy.
HUBTEL_PASS_FEES_TO_CUSTOMER=false
# Historical aliases also accepted:
# HUBTEL_API_ID=
# HUBTEL_API_KEY=
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=
# HUBTEL_BASE_URL=https://payproxyapi.hubtel.com

# Keep false until PadodaTagh is connected. true = testing only.
ALLOW_PAYMENTS_WITHOUT_DELIVERY=false

SUPPLIER_PENDING_ALERT_AFTER_MS=600000

# Primary data supplier (backend only)
PADODATAGH_API_KEY=
PADODATAGH_BASE_URL=https://padodatagh.online/api/v1
PADODATAGH_REQUEST_TIMEOUT_MS=20000
PADODATAGH_SYNC_INTERVAL_MS=900000

# Transactional SMS is disabled unless explicitly enabled on the backend.
# Use the separately provisioned SMS key when PadodaTagh provides one.
PADODATAGH_SMS_ENABLED=false
PADODATAGH_SMS_API_KEY=
PADODATAGH_SMS_BASE_URL=https://padodatagh.online/api/v1
PADODATAGH_SMS_REQUEST_TIMEOUT_MS=10000

# PadodaTagh is the exclusive supplier for new catalog offers and purchases.
# Historical RemaData order fields remain supported; no RemaData API integration is active.

# Only used by `npm run seed:admin`. Remove ADMIN_PASSWORD after seeding.
ADMIN_NAME=Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Email / SMTP Configuration (for password reset and notifications)
# In development, if unconfigured, reset links are logged to the backend console.
EMAIL_FROM=Rabs Data <support@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=


