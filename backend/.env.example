# Server
NODE_ENV=development
PORT=5000
# Comma separated if you have more than one (e.g. your Vercel URL and localhost)
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/rabsdata

# Auth (use 32+ random characters in production)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# App settings
WALLET_ENABLED=true
# Leave empty for all networks, or list e.g. MTN,Telecel
ENABLED_NETWORKS=

# Experiential Labs model gateway (OpenAI-compatible)
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=

# Payment provider (added in Phase 5 once you have the provider's docs)
#PAYMENT_PROVIDER=
#PAYMENT_PROVIDER_BASE_URL=
#PAYMENT_PROVIDER_SECRET_KEY=
#PAYMENT_WEBHOOK_SECRET=

# Public https URL of THIS backend. Hubtel calls it back here.
# Locally, use an ngrok URL (e.g. https://abcd.ngrok-free.app). On Render, your service URL.
API_PUBLIC_URL=http://localhost:5000

# Hubtel Payment Gateway (Online Checkout / Merchant API)
# Credentials stay strictly on the backend. Never expose to client-side.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# POS Sales Merchant Account Number
HUBTEL_MERCHANT_ACCOUNT=
# Base URLs (defaults match Hubtel standard endpoints)
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_STATUS_BASE_URL=https://api-txnstatus.hubtel.com
# Optional webhook token added to callback query parameter
HUBTEL_WEBHOOK_TOKEN=
# Fee handling: true = customer pays gateway fee; false = business absorbs fee (recorded as payment expense)
HUBTEL_PASS_FEES_TO_CUSTOMER=false
HUBTEL_FEE_PERCENTAGE=1.95
HUBTEL_FEE_FIXED=0

# Alternative variable name aliases also supported:
# HUBTEL_API_ID=
# HUBTEL_API_KEY=
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=
# HUBTEL_CHECKOUT_BASE_URL=

# Keep false until a data provider is connected. true = testing only.
ALLOW_PAYMENTS_WITHOUT_DELIVERY=false

# RemaData Supplier Integration (Backend only - NEVER expose to frontend or git)
REMADATA_API_KEY=
REMADATA_BASE_URL=https://remadata.com/api

# Data provider legacy aliases (optional)
DATA_PROVIDER_BASE_URL=https://remadata.com/api
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_SECRET=

# Only used by `npm run seed:admin`. Remove ADMIN_PASSWORD after seeding.
ADMIN_NAME=Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Email / SMTP Configuration (for password reset and notifications)
# In development, if unconfigured, reset links are logged to the backend console.
EMAIL_FROM=Rabs Data <support@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=


